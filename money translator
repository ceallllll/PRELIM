def main():
    exchange_rate = 0.92
    
    for i in range(1, 7):
        try:
            usd_price = float(input(f"Enter USD price for Product {i}: "))
            eur_price = usd_price * exchange_rate
            print(f"Product {i} price in EUR: €{eur_price:.2f}\n")
        except ValueError:
            print("Invalid input. Please enter a valid price.")

if __name__ == "__main__":
    main()
