def main():
    while True:
        print("\n=== Arithmetic Operations Calculator ===")
        print("1. Addition\n2. Subtraction\n3. Multiplication\n4. Division\n5. Modulus\n6. Increment\n7. Decrement")
        
        choice = input("Select an operation (1-7): ").strip()
        if choice not in ["1", "2", "3", "4", "5", "6", "7"]:
            print("Invalid option.")
            continue

        try:
            x = float(input("Enter value for x: "))
            if choice in ["1", "2", "3", "4", "5"]:
                y = float(input("Enter value for y: "))
        except ValueError:
            print("Please enter valid numbers.")
            continue

        print("\n--- Result ---")
        if choice == "1":
            print(f"{x} + {y} = {x + y}")
        elif choice == "2":
            print(f"{x} - {y} = {x - y}")
        elif choice == "3":
            print(f"{x} * {y} = {x * y}")
        elif choice == "4":
            print(f"{x} / {y} = {x / y}" if y != 0 else "Error: Division by zero.")
        elif choice == "5":
            print(f"{x} % {y} = {x % y}" if y != 0 else "Error: Modulus by zero.")
        elif choice == "6":
            print(f"Incremented {x} is {x + 1}")
        elif choice == "7":
            print(f"Decremented {x} is {x - 1}")

        repeat = input("\nDo you want to continue? (YES/NO): ").strip().upper()
        if repeat == "NO":
            print("Program terminated. Thank you!")
            break

if __name__ == "__main__":
    main()
